# Root gitignore for TutorialSync monorepo

# Dependencies
node_modules/
**/node_modules/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.production
.env.development
**/.env
**/.env.local
**/.env.production
**/.env.development

# Build output
dist/
**/dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

