# ============================================================
# TutorialSync Backend - Environment Variables
# Copy this file to .env for local dev.
# For Railway/Render: add these as environment variables in dashboard.
# ============================================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devrefresh?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_very_long_random_jwt_secret_here
JWT_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Your Vercel frontend URL (no trailing slash)
# Supports comma-separated list: https://yourapp.vercel.app,http://localhost:5173
CLIENT_URL=https://your-app.vercel.app

# Gemini API Keys
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TUTORIAL_API_KEY=your_gemini_tutorial_api_key
GEMINI_CHAT_API_KEY=your_gemini_chat_api_key
GEMINI_MODEL=gemini-flash-latest

